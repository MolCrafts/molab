    {
      "name": "Icon Action",
      "kind": "button",
      "refersTo": "action-icon",
      "description": "Borderless workbench action; name and title remain available.",
      "html": "<button class=\"ds-action\" aria-label=\"Refresh\" title=\"Refresh\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" aria-hidden=\"true\"><path d=\"M3 11a9 9 0 0 1 15.5-6.5L21 7M21 3v4h-4M21 13a9 9 0 0 1-15.5 6.5L3 17M3 21v-4h4\"/></svg></button>",
      "css": ".ds-action{display:inline-flex;align-items:center;justify-content:center;width:1.75rem;height:1.75rem;padding:0;border:0;border-radius:0.375rem;background:transparent;color:var(--molab-foreground,#242424);box-shadow:none;cursor:pointer;transition:background-color var(--motion-fast,120ms) var(--motion-ease,cubic-bezier(0.2,0,0,1))}.ds-action svg{width:1rem;height:1rem;stroke-width:1.5}.ds-action:hover,.ds-action:active{background:var(--molab-interactive,#e8e8e8)}.ds-action:focus-visible{outline:var(--focus-width,2px) solid var(--molab-accent,#005fb8);outline-offset:var(--focus-offset,2px)}.ds-action:disabled{opacity:.5;pointer-events:none}@media(pointer:coarse){.ds-action{min-width:2.75rem;min-height:2.75rem}}@media(prefers-reduced-motion:reduce){.ds-action{transition:none}}"
    },
    {
      "name": "Danger Action",
      "kind": "button",
      "refersTo": "action-danger",
      "description": "Same compact action geometry with semantic destructive color.",
      "html": "<button class=\"ds-action ds-danger\" aria-label=\"Delete\" title=\"Delete\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" aria-hidden=\"true\"><path d=\"M3 6h18M9 6V4h6v2M5 6l1 14h12l1-14M10 10v6M14 10v6\"/></svg></button>",
      "css": ".ds-action{display:inline-flex;align-items:center;justify-content:center;width:1.75rem;height:1.75rem;padding:0;border:0;border-radius:0.375rem;background:transparent;color:var(--molab-foreground,#242424);box-shadow:none;cursor:pointer;transition:background-color var(--motion-fast,120ms) var(--motion-ease,cubic-bezier(0.2,0,0,1))}.ds-action svg{width:1rem;height:1rem;stroke-width:1.5}.ds-action:hover,.ds-action:active{background:var(--molab-interactive,#e8e8e8)}.ds-action:focus-visible{outline:var(--focus-width,2px) solid var(--molab-accent,#005fb8);outline-offset:var(--focus-offset,2px)}.ds-action:disabled{opacity:.5;pointer-events:none}@media(pointer:coarse){.ds-action{min-width:2.75rem;min-height:2.75rem}}@media(prefers-reduced-motion:reduce){.ds-action{transition:none}}.ds-danger{color:var(--status-failed,oklch(0.58 0.19 25))}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Quiet, bounded field with body typography and visible focus.",
      "html": "<input class=\"ds-input\" aria-label=\"Name\" placeholder=\"Name\"/>",
      "css": ".ds-input{width:100%;min-width:0;height:2rem;padding:.25rem .75rem;border:1px solid var(--molab-input,#cecece);border-radius:.375rem;background:var(--molab-surface,#fff);color:var(--molab-foreground,#242424);font:400 .8125rem/1.4 var(--font-sans,\"Geist\",\"Inter\",sans-serif);transition:border-color var(--motion-fast,120ms)}.ds-input::placeholder{color:var(--molab-muted-foreground,#616161)}.ds-input:hover{border-color:var(--input-hover,var(--molab-input,#cecece))}.ds-input:focus-visible{outline:var(--focus-width,2px) solid var(--molab-accent,#005fb8);outline-offset:var(--focus-offset,2px);border-bottom-color:var(--molab-accent,#005fb8)}.ds-input:disabled{opacity:.5;pointer-events:none}@media(pointer:coarse){.ds-input{min-height:2.75rem}}@media(prefers-reduced-motion:reduce){.ds-input{transition:none}}"
    },
    {
      "name": "Entity Tabs",
      "kind": "nav",
      "refersTo": "entity-tab",
      "description": "Text navigation with a content-connected active tab. Preview links represent visual states only.",
      "html": "<nav class=\"ds-tabs\" aria-label=\"Entity views\"><a class=\"ds-tab ds-tab-active\" href=\"#overview\" aria-current=\"page\">Overview</a><a class=\"ds-tab\" href=\"#runs\">Runs</a></nav>",
      "css": ".ds-tabs{display:flex;height:2rem;overflow-x:auto;border-bottom:1px solid var(--molab-border,#e5e5e5);background:var(--molab-surface-subtle,#f3f3f3)}.ds-tab{display:inline-flex;align-items:center;flex:none;padding:0 1rem;border-right:1px solid var(--molab-border,#e5e5e5);border-radius:0;color:var(--molab-muted-foreground,#616161);font:500 .75rem/1.4 var(--font-sans,\"Geist\",\"Inter\",sans-serif);text-decoration:none}.ds-tab:hover{color:var(--molab-foreground,#242424)}.ds-tab:focus-visible{outline:none;background:var(--molab-interactive,#e8e8e8)}.ds-tab-active{border-top:1px solid var(--molab-accent,#005fb8);background:var(--molab-background,#fff);color:var(--molab-foreground,#242424)}"
    },
    {
      "name": "Category Tag",
      "kind": "chip",
      "refersTo": "tag-category",
      "description": "Compact annotation; a data label rather than an action.",
      "html": "<span class=\"ds-tag\">Category</span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;gap:.25rem;padding:0 .5rem;border:1px solid var(--molab-border,#e5e5e5);border-radius:.375rem;background:var(--molab-muted,#eee);color:var(--molab-muted-foreground,#616161);font:500 .6875rem/1.4 var(--font-sans,\"Geist\",\"Inter\",sans-serif)}"
    },
    {
      "name": "Dashboard Section",
      "kind": "card",
      "refersTo": "dashboard-section",
      "description": "Legacy DashboardCard is an unframed section on the shared canvas, kept for settings and detail tabs; workspace and project Overviews use Gauge frames instead.",
      "html": "<section class=\"ds-section\" aria-labelledby=\"ds-section-title\"><header class=\"ds-section-header\"><h3 id=\"ds-section-title\">Runs</h3><span class=\"ds-count\">12</span></header><div class=\"ds-section-body\">Section content</div></section>",
      "css": ".ds-section{min-width:0;background:var(--molab-background,#fff);color:var(--molab-foreground,#242424);font:400 .8125rem/1.4 var(--font-sans,\"Geist\",\"Inter\",sans-serif)}.ds-section-header{display:flex;align-items:center;gap:.5rem;height:1.75rem;padding:0 .75rem}.ds-section-header h3{margin:0;font-size:.75rem;font-weight:500}.ds-count{font:.6875rem/1.4 var(--font-mono,\"JetBrains Mono\",monospace);font-variant-numeric:tabular-nums;color:var(--molab-muted-foreground,#616161)}.ds-section-body{padding:.5rem .75rem}"
    },
    {
      "name": "Instrument Strip",
      "kind": "custom",
      "description": "Overview band of gauges: shared top/bottom hairline, hairline dividers, no card frames; a cell that summarises a list opens that list's tab.",
      "html": "<section class=\"ds-strip\" aria-label=\"Execution gauges\"><div class=\"ds-cell\"><span class=\"ds-cell-head\"><span>Run duration</span></span><span class=\"ds-fig\">48m</span><span class=\"ds-cap\">median of 12 finished runs</span></div><button type=\"button\" class=\"ds-cell ds-cell-btn\" aria-label=\"In flight: 3 running, 1 queued executions. Open the timeline\"><span class=\"ds-cell-head\"><span>In flight</span><span class=\"ds-hint\">Timeline<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"/></svg></span></span><span class=\"ds-fig\">4</span><span class=\"ds-cap\">executions: 3 running, 1 queued</span><span class=\"ds-meter\" aria-hidden=\"true\"><i class=\"ds-run\"></i><i class=\"ds-run\"></i><i class=\"ds-run\"></i><i class=\"ds-queued\"></i></span></button></section>",
      "css": ".ds-strip{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--molab-border,#e5e5e5);border-bottom:1px solid var(--molab-border,#e5e5e5);font:400 .8125rem/1.4 var(--font-sans,\"Geist\",\"Inter\",sans-serif);color:var(--molab-foreground,#242424);background:var(--molab-background,#fff)}.ds-cell{display:flex;flex-direction:column;gap:.125rem;padding:.75rem 1rem;min-width:0;text-align:left;font:inherit;color:inherit;background:transparent;border:0}.ds-cell+.ds-cell{border-left:1px solid var(--molab-border,#e5e5e5)}.ds-cell-head{display:flex;align-items:center;gap:.5rem;font-size:.75rem;font-weight:500}.ds-hint{margin-left:auto;display:flex;align-items:center;font-size:.6875rem;font-weight:400;color:var(--molab-muted-foreground,#616161);transition:color .15s}.ds-fig{margin-top:.5rem;font-size:1rem;font-weight:600;line-height:1.25;font-variant-numeric:tabular-nums}.ds-cap{font-size:.75rem;color:var(--molab-muted-foreground,#616161)}.ds-meter{display:flex;gap:.25rem;height:2rem;align-items:flex-end;margin-top:.75rem}.ds-meter i{display:block;width:.75rem;height:2rem;border-radius:.125rem}.ds-run{background:var(--status-running,oklch(0.62 0.15 250))}.ds-queued{border:1px solid var(--status-queued,oklch(0.62 0.04 250))}.ds-cell-btn{cursor:pointer;outline:none;transition:background-color .15s}.ds-cell-btn:hover,.ds-cell-btn:focus-visible{background:color-mix(in srgb,var(--molab-interactive,#e8e8e8) 50%,transparent)}.ds-cell-btn:hover .ds-hint,.ds-cell-btn:focus-visible .ds-hint{color:var(--molab-foreground,#242424)}.ds-cell-btn:focus-visible{box-shadow:inset 0 0 0 1px var(--molab-accent,#005fb8)}"
    }
  ],
  "narrative": {
    "northStar": "VS Code Compact",
    "overview": "VS Code Compact is the confirmed visual direction: a precise, quiet, confident scientific operator console. Dashboard, workspace, and settings share neutral surfaces, compact chrome, restrained blue selection and focus, and short operational language. Light is the default; dark is an explicit reading preference.\n\nDensity serves browsing, comparison, and recovery. Borderless icon actions keep chrome small; navigation, field choices, status, counts, and scientific meaning retain the text needed to understand them. Keep the existing shared component vocabulary and geometry rather than introducing another visual system.",
    "keyCharacteristics": [
      "Compact, connected work surfaces with quiet separators.",
      "Borderless icon actions with accessible names and hover titles.",
      "Readable scientific data, explicit state, and restrained selection color."
    ],
    "rules": [
      {
        "name": "The Accent Has a Job Rule",
        "body": "Blue identifies selection and focus; it is not decoration around every section.",
        "section": "colors"
      },
      {
        "name": "The Gauge Opens Its List Rule",
        "body": "An instrument that summarises a list is a button that opens that list's tab. It shows a persistent “Timeline ›” or “List ›” hint at rest. The list itself lives behind the tab.",
        "section": "components"
      },
      {
        "name": "The One Gesture Grammar Rule",
        "body": "Every Overview chart is a Vega-Lite view and answers the same gestures. Hover keeps the mark, or its whole row or bucket, at full ink, recedes the rest to 0.32, and shows a one-sentence tooltip. Click opens what the mark stands for: a run, a project or experiment, the Attention tab for a failed or cancelled dial segment. Drag a window across Activity, or click a backend (click again to release it), to filter the rest of the Overview; a filter strip names what is applied and clears it. Click is a view listener, not a point selection, so a second click on the same mark still registers.",
        "section": "components"
      },
      {
        "name": "The Outlined Queue Rule",
        "body": "Wherever queued appears in a status mix (distribution segment, legend dot, unit mark), draw it as an outline, never a fill. That is its non-color cue apart from cancelled grey.",
        "section": "components"
      }
    ],
    "dos": [
      "Do reuse workbench actions, entity tabs, dashboard sections, settings rows, the shared Overview gauges, and the shared ArcChart where StatusLedger leads an experiment or run overview.",
      "Do retain text for navigation, data choices, status, units, counts, and parameter meaning.",
      "Do keep retry, dismiss, cancel, and denied-action explanations available.",
      "Do preserve visible keyboard focus, non-color status cues, tabular numbers, and coarse-pointer targets."
    ],
    "donts": [
      "Don't add nested card scaffolding, decorative gradients, rainbow chrome, or redundant explanatory copy.",
      "Don't turn navigation and data choices into anonymous icons.",
      "Don't invent another palette, type scale, or button vocabulary for a new screen.",
      "Don't present seeded example captures or partial counts as verified live HPC results."
    ]
  }
}

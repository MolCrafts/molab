  "components": [
    {
      "name": "Icon Action",
      "kind": "button",
      "refersTo": "action-icon",
      "description": "Borderless workbench action; name and title remain available.",
      "html": "<button class=\"ds-action\" aria-label=\"Refresh\" title=\"Refresh\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" aria-hidden=\"true\"><path d=\"M3 11a9 9 0 0 1 15.5-6.5L21 7M21 3v4h-4M21 13a9 9 0 0 1-15.5 6.5L3 17M3 21v-4h4\"/></svg></button>",
      "css": ".ds-action{display:inline-flex;align-items:center;justify-content:center;width:1.75rem;height:1.75rem;padding:0;border:0;border-radius:0.375rem;background:transparent;color:var(--molab-foreground,#242424);box-shadow:none;cursor:pointer;transition:background-color var(--motion-fast,120ms) var(--motion-ease,cubic-bezier(0.2,0,0,1))}.ds-action svg{width:1rem;height:1rem;stroke-width:1.5}.ds-action:hover,.ds-action:active{background:var(--molab-interactive,#e8e8e8)}.ds-action:focus-visible{outline:var(--focus-width,2px) solid var(--molab-accent,#005fb8);outline-offset:var(--focus-offset,2px)}.ds-action:disabled{opacity:.5;pointer-events:none}@media(pointer:coarse){.ds-action{min-width:2.75rem;min-height:2.75rem}}@media(prefers-reduced-motion:reduce){.ds-action{transition:none}}"
    },
    {
      "name": "Danger Action",
      "kind": "button",
      "refersTo": "action-danger",
      "description": "Same compact action geometry with semantic destructive color.",
      "html": "<button class=\"ds-action ds-danger\" aria-label=\"Delete\" title=\"Delete\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" aria-hidden=\"true\"><path d=\"M3 6h18M9 6V4h6v2M5 6l1 14h12l1-14M10 10v6M14 10v6\"/></svg></button>",
      "css": ".ds-action{display:inline-flex;align-items:center;justify-content:center;width:1.75rem;height:1.75rem;padding:0;border:0;border-radius:0.375rem;background:transparent;color:var(--molab-foreground,#242424);box-shadow:none;cursor:pointer;transition:background-color var(--motion-fast,120ms) var(--motion-ease,cubic-bezier(0.2,0,0,1))}.ds-action svg{width:1rem;height:1rem;stroke-width:1.5}.ds-action:hover,.ds-action:active{background:var(--molab-interactive,#e8e8e8)}.ds-action:focus-visible{outline:var(--focus-width,2px) solid var(--molab-accent,#005fb8);outline-offset:var(--focus-offset,2px)}.ds-action:disabled{opacity:.5;pointer-events:none}@media(pointer:coarse){.ds-action{min-width:2.75rem;min-height:2.75rem}}@media(prefers-reduced-motion:reduce){.ds-action{transition:none}}.ds-danger{color:var(--status-failed,oklch(0.58 0.19 25))}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Quiet, bounded field with body typography and visible focus.",
      "html": "<input class=\"ds-input\" aria-label=\"Name\" placeholder=\"Name\"/>",
      "css": ".ds-input{width:100%;min-width:0;height:2rem;padding:.25rem .75rem;border:1px solid var(--molab-input,#cecece);border-radius:.375rem;background:var(--molab-surface,#fff);color:var(--molab-foreground,#242424);font:400 .8125rem/1.4 var(--font-sans,\"Geist\",\"Inter\",sans-serif);transition:border-color var(--motion-fast,120ms)}.ds-input::placeholder{color:var(--molab-muted-foreground,#616161)}.ds-input:hover{border-color:var(--input-hover,var(--molab-input,#cecece))}.ds-input:focus-visible{outline:var(--focus-width,2px) solid var(--molab-accent,#005fb8);outline-offset:var(--focus-offset,2px);border-bottom-color:var(--molab-accent,#005fb8)}.ds-input:disabled{opacity:.5;pointer-events:none}@media(pointer:coarse){.ds-input{min-height:2.75rem}}@media(prefers-reduced-motion:reduce){.ds-input{transition:none}}"
    },
    {
      "name": "Entity Tabs",
      "kind": "nav",
      "refersTo": "entity-tab",
      "description": "Text navigation with a content-connected active tab. Preview links represent visual states only.",
      "html": "<nav class=\"ds-tabs\" aria-label=\"Entity views\"><a class=\"ds-tab ds-tab-active\" href=\"#overview\" aria-current=\"page\">Overview</a><a class=\"ds-tab\" href=\"#runs\">Runs</a></nav>",
      "css": ".ds-tabs{display:flex;height:2rem;overflow-x:auto;border-bottom:1px solid var(--molab-border,#e5e5e5);background:var(--molab-surface-subtle,#f3f3f3)}.ds-tab{display:inline-flex;align-items:center;flex:none;padding:0 1rem;border-right:1px solid var(--molab-border,#e5e5e5);border-radius:0;color:var(--molab-muted-foreground,#616161);font:500 .75rem/1.4 var(--font-sans,\"Geist\",\"Inter\",sans-serif);text-decoration:none}.ds-tab:hover{color:var(--molab-foreground,#242424)}.ds-tab:focus-visible{outline:none;background:var(--molab-interactive,#e8e8e8)}.ds-tab-active{border-top:1px solid var(--molab-accent,#005fb8);background:var(--molab-background,#fff);color:var(--molab-foreground,#242424)}"
    },
    {
      "name": "Category Tag",
      "kind": "chip",
      "refersTo": "tag-category",
      "description": "Compact annotation; a data label rather than an action.",
      "html": "<span class=\"ds-tag\">Category</span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;gap:.25rem;padding:0 .5rem;border:1px solid var(--molab-border,#e5e5e5);border-radius:.375rem;background:var(--molab-muted,#eee);color:var(--molab-muted-foreground,#616161);font:500 .6875rem/1.4 var(--font-sans,\"Geist\",\"Inter\",sans-serif)}"
    },
    {
      "name": "Dashboard Section",
      "kind": "card",
      "refersTo": "dashboard-section",
      "description": "Legacy DashboardCard is an unframed section on the shared canvas.",
      "html": "<section class=\"ds-section\" aria-labelledby=\"ds-section-title\"><header class=\"ds-section-header\"><h3 id=\"ds-section-title\">Runs</h3><span class=\"ds-count\">12</span></header><div class=\"ds-section-body\">Section content</div></section>",
      "css": ".ds-section{min-width:0;background:var(--molab-background,#fff);color:var(--molab-foreground,#242424);font:400 .8125rem/1.4 var(--font-sans,\"Geist\",\"Inter\",sans-serif)}.ds-section-header{display:flex;align-items:center;gap:.5rem;height:1.75rem;padding:0 .75rem}.ds-section-header h3{margin:0;font-size:.75rem;font-weight:500}.ds-count{font:.6875rem/1.4 var(--font-mono,\"JetBrains Mono\",monospace);font-variant-numeric:tabular-nums;color:var(--molab-muted-foreground,#616161)}.ds-section-body{padding:.5rem .75rem}"
    }
